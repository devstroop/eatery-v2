<!-- The app shell: a title bar, the role's navigation rail, the current
     screen, and a status bar.

     The rail is a list of the sections the CURRENT ROLE may open, so it
     can never show a destination the role is not allowed to use. The
     content pane is a set of <if> gates over the screen templates -
     only the active screen is mounted, which is what keeps the widget
     budget (1024 nodes per view) within reach.

     The screen positions are the `core/navigation.zig` enum indices.
     That enum is append-only: adding a screen means appending it, so
     the numbers here stay true. -->


<import src="screens/screen-session.native"/>
<import src="screens/screen-overview.native"/>
<import src="screens/screen-sell.native"/>
<import src="screens/screen-orders.native"/>
<import src="screens/screen-floor.native"/>
<import src="screens/screen-catalog.native"/>
<import src="screens/screen-people.native"/>
<import src="screens/screen-settings.native"/>
<import src="screens/screen-service.native"/>
<import src="screens/screen-kitchen.native"/>

<column grow="1" background="background">
  <row padding="12" gap="8" cross="center" background="surface">
    <text size="lg" grow="1">{company_label}</text>
    <badge>{role_label}</badge>
    <button size="sm" variant="ghost" on-press="toggle_theme">Theme</button>
  </row>

  <if test="{has_error}">
    <row padding="8" gap="8" cross="center" background="destructive">
      <text foreground="destructive_text" grow="1">{error_message}</text>
      <button size="sm" variant="ghost" on-press="dismiss_error">Dismiss</button>
    </row>
  </if>

  <if test="{show_setup}">
    <use template="screen-setup"/>
  </if>

  <if test="{show_role_picker}">
    <use template="screen-role-picker"/>
  </if>

  <if test="{show_login}">
    <use template="screen-login"/>
  </if>

  <if test="{show_shell}">
    <split grow="1" value="{rail_split}" on-resize="rail_resized">
      <column width="200" gap="2" padding="12" background="surface">
        <text size="sm" foreground="text_muted">NAVIGATION</text>
        <for each="nav_sections" key="id" as="section">
          <list-item selected="{section.id == nav_section}" on-press="open_section:{section.id}">{section.label}</list-item>
        </for>
        <separator/>
        <text size="sm" foreground="text_muted">{operator_label}</text>
      </column>
      <column grow="1">
        <if test="{screen_index == 8}"><use template="screen-dashboard"/></if>
        <if test="{screen_index == 10}"><use template="screen-pos"/></if>
        <if test="{screen_index == 13}"><use template="screen-orders"/></if>
        <if test="{screen_index == 14}"><use template="screen-order-detail"/></if>
        <if test="{screen_index == 16}"><use template="screen-customers"/></if>
        <if test="{screen_index == 20}"><use template="screen-reservations"/></if>
        <if test="{screen_index == 24}"><use template="screen-suppliers"/></if>
        <if test="{screen_index == 25}"><use template="screen-purchase-orders"/></if>
        <if test="{screen_index == 17}"><use template="screen-tables"/></if>
        <if test="{screen_index == 12}"><use template="screen-order-confirmation"/></if>
        <if test="{screen_index == 37}"><use template="screen-waiter-tables"/></if>
        <if test="{screen_index == 38}"><use template="screen-waiter-menu"/></if>
        <if test="{screen_index == 39}"><use template="screen-waiter-cart"/></if>
        <if test="{screen_index == 40}"><use template="screen-waiter-orders"/></if>
        <if test="{screen_index == 41}"><use template="screen-kitchen"/></if>
        <if test="{screen_index == 23}"><use template="screen-catalogue-list"/></if>
        <if test="{screen_index == 26}"><use template="screen-employees-list"/></if>
        <if test="{screen_index == 30}"><use template="screen-settings-printers"/></if>
        <if test="{screen_index == 31}"><use template="screen-settings-tax"/></if>
        <if test="{screen_index == 32}"><use template="screen-settings-currency"/></if>
        <if test="{screen_index == 33}"><use template="screen-settings-modifiers"/></if>
        <if test="{screen_index == 34}"><use template="screen-settings-discounts"/></if>
        <if test="{screen_index == 35}"><use template="screen-settings-data"/></if>
        <if test="{screen_index == 43}"><use template="screen-product-form"/></if>
        <if test="{screen_index == 44}"><use template="screen-employee-form"/></if>
        <if test="{screen_index == 45}"><use template="screen-tax-slab-form"/></if>
        <if test="{screen_index == 46}"><use template="screen-discount-form"/></if>
        <if test="{screen_index == 47}"><use template="screen-category-form"/></if>
        <if test="{screen_index == 48}"><use template="screen-categories"/></if>
        <if test="{screen_index == 4}"><use template="screen-wizard"/></if>
        <if test="{screen_index == 5}"><use template="screen-create-company"/></if>
        <if test="{screen_index == 6}"><use template="screen-reset-pin"/></if>
        <if test="{screen_index == 42}"><use template="screen-display"/></if>
        <if test="{screen_index == 28}"><use template="screen-settings"/></if>
        <if test="{screen_index == 29}"><use template="screen-settings-company"/></if>
      </column>
    </split>
  </if>

  <status-bar>{screen_title} | {company_label} | {operator_label}</status-bar>
</column>
