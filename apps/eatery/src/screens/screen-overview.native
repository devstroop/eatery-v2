<!-- The the overview: what the day looks like.

     The screens of one area share one file: the shell's import closure
     allows thirty-two files, and the app is a product with more screens
     than that. A file may hold several templates, so a screen that
     shares a file with its neighbours costs nothing. -->

<!-- The dashboard: what the restaurant looks like right now. Four
     numbers, the open orders, and the shortcuts an owner reaches for.
     Every number is a derived binding - the dashboard stores nothing. -->

<template name="screen-dashboard">
  <column grow="1" gap="12" padding="16" background="background">
    <row gap="8" cross="center">
      <text size="heading" grow="1">Dashboard</text>
      <text foreground="text_muted">{company_label}</text>
    </row>

    <row gap="12">
      <card padding="16" grow="1">
        <column gap="4">
          <text size="sm" foreground="text_muted">OPEN ORDERS</text>
          <text size="display">{open_order_count}</text>
        </column>
      </card>
      <card padding="16" grow="1">
        <column gap="4">
          <text size="sm" foreground="text_muted">TABLES BUSY</text>
          <text size="display">{occupied_table_count}</text>
        </column>
      </card>
      <card padding="16" grow="1">
        <column gap="4">
          <text size="sm" foreground="text_muted">ON THE MENU</text>
          <text size="display">{product_count}</text>
        </column>
      </card>
      <card padding="16" grow="1">
        <column gap="4">
          <text size="sm" foreground="text_muted">TABLES</text>
          <text size="display">{table_count}</text>
        </column>
      </card>
    </row>

    <row gap="8">
      <button variant="primary" on-press="open_pos">New order</button>
      <button variant="secondary" on-press="open_orders">Orders</button>
      <button variant="secondary" on-press="open_tables">Floor</button>
      <spacer grow="1"/>
      <button variant="ghost" on-press="sign_out">Sign out</button>
    </row>

    <text size="lg">Everything else</text>
    <grid columns="3" gap="8">
      <for each="overview_links" key="id" as="link">
        <card padding="12" on-press="open_screen:{link.id}">
          <column gap="2">
            <text>{link.title}</text>
            <text size="sm" foreground="text_muted">{link.detail}</text>
          </column>
        </card>
      </for>
    </grid>

    <text size="lg">Recent orders</text>
    <if test="{order_count == 0}">
      <column background="surface" radius="md" padding="16">
        <text foreground="text_muted">No orders yet. The kitchen board fills up as soon as the first sale lands.</text>
      </column>
    </if>
    <if test="{order_count > 0}">
      <column gap="4">
        <for each="orders" key="id" as="order">
          <row background="surface" radius="md" padding="8" gap="8" cross="center">
            <text grow="1">{order.order_no}</text>
            <badge>{order.status_label}</badge>
            <text>{currency_symbol}{fixed(order.total_minor / currency_divisor, currency_decimal_count)}</text>
          </row>
        </for>
      </column>
    </if>
  </column>
</template>
