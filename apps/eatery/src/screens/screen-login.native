<!-- The sign-in screen: a PIN pad. The PIN is never stored in the
     clear - `update` hashes it with the installation salt and asks the
     database whether anybody matches. The error line comes from the
     model, so the view never decides whether a sign-in failed. -->

<template name="screen-login">
  <column grow="1" gap="12" padding="32" main="center" cross="center" background="background">
    <text size="heading">Sign in</text>
    <text foreground="text_muted">{role_label} - enter your PIN</text>

    <card padding="16" width="320">
      <column gap="8">
        <text-field
          text="{pin_text}"
          placeholder="PIN"
          label="PIN"
          on-input="pin_edit"
          on-submit="submit_login"
          autofocus="true"
        />
        <if test="{login_failed}">
          <text foreground="destructive">{login_error}</text>
        </if>
        <button variant="primary" on-press="submit_login">Sign in</button>
        <button variant="ghost" on-press="pick_role_again">Change role</button>
      </column>
    </card>
  </column>
</template>
