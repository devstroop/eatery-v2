<!-- The waiter's open orders: every table that is waiting on food. -->

<template name="screen-waiter-orders">
  <column grow="1" gap="12" padding="16" background="background">
    <text size="heading">Open orders</text>

    <if test="{order_count == 0}">
      <column background="surface" radius="md" padding="16">
        <text foreground="text_muted">No open orders.</text>
      </column>
    </if>

    <scroll grow="1">
      <column gap="4">
        <for each="orders" key="id" as="order">
          <row background="surface" radius="md" padding="10" gap="10" cross="center">
            <text grow="1">{order.order_no}</text>
            <badge>{order.status_label}</badge>
            <text>{currency_symbol}{fixed(order.total_minor / currency_divisor, currency_decimal_count)}</text>
          </row>
        </for>
      </column>
    </scroll>
  </column>
</template>
