<!-- The discounts the cashier can apply: a percentage, a fixed
     amount, or both. -->

<template name="screen-settings-discounts">
  <column grow="1" gap="12" padding="16" background="background">
    <row gap="8" cross="center">
      <text size="heading" grow="1">Discounts</text>
      <badge>{discount_count} discounts</badge>
      <button size="sm" variant="ghost" on-press="open_settings">Back</button>
    </row>

    <if test="{discount_count == 0}">
      <column background="surface" radius="md" padding="16">
        <text foreground="text_muted">No discounts yet.</text>
      </column>
    </if>

    <scroll grow="1">
      <column gap="4">
        <for each="discounts" key="id" as="discount">
          <row background="surface" radius="md" padding="10" gap="10" cross="center">
            <text grow="1">{discount.name}</text>
            <text>{discount.value_label}</text>
          </row>
        </for>
      </column>
    </scroll>
  </column>
</template>
