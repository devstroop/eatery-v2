<!-- The order confirmation: what was just sold, and the money.
     This is the end of the sale - the order is on the kitchen board, the
     customer is waiting, and the cashier takes the payment here. -->

<template name="screen-order-confirmation">
  <column grow="1" gap="12" padding="24" main="center" cross="center" background="background">
    <text size="heading">Order {last_order_no}</text>
    <text foreground="text_muted">{last_order_type} - {time(last_order_time)}</text>

    <card padding="16" width="380">
      <column gap="8">
        <row cross="center">
          <text grow="1" foreground="text_muted">Items</text>
          <text>{last_order_items}</text>
        </row>
        <separator/>
        <row cross="center">
          <text grow="1" size="lg">Total</text>
          <text size="lg">{currency_symbol}{fixed(last_order_total / 100, 2)}</text>
        </row>
      </column>
    </card>

    <if test="{payment_failed}">
      <text foreground="destructive">{payment_error}</text>
    </if>

    <column gap="8" width="380">
      <text size="sm" foreground="text_muted">TAKE THE PAYMENT</text>
      <row gap="8">
        <for each="payment_modes" key="id" as="mode">
          <toggle-button selected="{mode.id == payment_mode}" on-toggle="set_payment_mode:{mode.id}">{mode.label}</toggle-button>
        </for>
      </row>
      <row gap="8">
        <button variant="ghost" on-press="back_to_pos">Another order</button>
        <button variant="primary" grow="1" on-press="take_payment">Take {currency_symbol}{fixed(last_order_total / 100, 2)}</button>
      </row>
    </column>
  </column>
</template>
