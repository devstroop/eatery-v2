<!-- The printers. A receipt printer and a kitchen printer, and where
     each of them is. The transport is what the sidecar will use to
     reach the device: a Bluetooth address, a host:port, a file. -->

<template name="screen-settings-printers">
  <column grow="1" gap="12" padding="16" background="background">
    <row gap="8" cross="center">
      <text size="heading" grow="1">Printers</text>
      <badge>{printer_count} configured</badge>
      <button size="sm" variant="ghost" on-press="open_settings">Back</button>
    </row>

    <if test="{printer_count == 0}">
      <column background="surface" radius="md" padding="16">
        <text foreground="text_muted">No printers yet. Add one to print receipts.</text>
      </column>
    </if>

    <scroll grow="1">
      <column gap="4">
        <for each="printers" key="id" as="printer">
          <row background="surface" radius="md" padding="10" gap="10" cross="center">
            <column gap="2" grow="1">
              <text>{printer.name}</text>
              <text size="sm" foreground="text_muted">{printer.transport} - {printer.address}</text>
            </column>
            <badge>{printer.job}</badge>
          </row>
        </for>
      </column>
    </scroll>
  </column>
</template>
