<!-- The company's details: the name that is on every receipt, the
     address, the phone and the tax number. The form starts from the
     stored company, so opening the screen shows what is saved rather
     than an empty form. -->

<template name="screen-settings-company">
  <column grow="1" gap="12" padding="16" background="background">
    <row gap="8" cross="center">
      <text size="heading" grow="1">Company</text>
      <badge>{company_currency_code}</badge>
    </row>

    <card padding="16" width="520">
      <column gap="8">
        <text-field
          text="{form_company_name}"
          placeholder="The name on the receipt"
          label="Restaurant name"
          on-input="form_company_name_edit"
        />
        <text-field
          text="{form_company_address}"
          placeholder="Street, city"
          label="Address"
          on-input="form_company_address_edit"
        />
        <text-field
          text="{form_company_phone}"
          placeholder="+91 ..."
          label="Phone"
          on-input="form_company_phone_edit"
        />
        <text-field
          text="{form_company_tax}"
          placeholder="GSTIN, VAT number, ..."
          label="Tax number"
          on-input="form_company_tax_edit"
        />
        <row gap="8">
          <button variant="ghost" on-press="open_settings">Back</button>
          <spacer grow="1"/>
          <button variant="primary" on-press="save_company">Save</button>
        </row>
      </column>
    </card>
  </column>
</template>
