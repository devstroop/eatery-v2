<!-- The the session: setting up, choosing a role, signing in.

     The screens of one area share one file: the shell's import closure
     allows thirty-two files, and the app is a product with more screens
     than that. A file may hold several templates, so a screen that
     shares a file with its neighbours costs nothing. -->

<!-- The first-run setup: the one screen a fresh installation shows.
     It creates the company, the first operator and their PIN, and it
     writes a starter menu and floor so the app is usable the moment it
     is set up. The button stays disabled until the form is complete -
     the model decides that, not the markup. -->

<template name="screen-setup">
  <column grow="1" gap="12" padding="32" main="center" cross="center" background="background">
    <text size="heading">Set up your restaurant</text>
    <text foreground="text_muted">This takes a minute. Everything here can be changed later.</text>

    <card padding="16" width="440">
      <column gap="8">
        <text-field
          text="{setup_company_text}"
          placeholder="e.g. Sharma Restaurant"
          label="Restaurant name"
          on-input="setup_company_edit"
        />
        <text-field
          text="{setup_admin_text}"
          placeholder="e.g. Anita"
          label="Your name"
          on-input="setup_admin_edit"
        />
        <row gap="8">
          <text-field
            text="{setup_currency_text}"
            placeholder="USD"
            label="Currency code"
            on-input="setup_currency_edit"
            grow="1"
          />
          <text-field
            text="{setup_symbol_text}"
            placeholder="$"
            label="Symbol"
            on-input="setup_symbol_edit"
            grow="1"
          />
        </row>
        <row gap="8">
          <text-field
            text="{setup_pin_text}"
            placeholder="6 digits"
            label="PIN"
            on-input="setup_pin_edit"
            grow="1"
          />
          <text-field
            text="{setup_pin2_text}"
            placeholder="again"
            label="Confirm PIN"
            on-input="setup_pin2_edit"
            grow="1"
          />
        </row>

        <if test="{setup_failed}">
          <text foreground="destructive">{setup_error_text}</text>
        </if>

        <button variant="primary" disabled="{setup_incomplete}" on-press="setup_submit">Create the restaurant</button>
        <text size="sm" foreground="text_muted">A starter menu and six tables are created with it. Edit them from the menu any time.</text>
      </column>
    </card>
  </column>
</template>

<!-- The role picker: the first screen of the app. A device runs one
     role at a time, and the role decides which whole app the operator
     sees - admin, waiter, kitchen display or customer display. The
     choice is a message, not a route change: `update` moves the model
     and the shell redraws. -->

<template name="screen-role-picker">
  <column grow="1" gap="16" padding="32" main="center" cross="center" background="background">
    <text size="display">Eatery</text>
    <text foreground="text_muted">Choose how this device works today.</text>

    <column gap="8" width="420">
      <for each="roles" key="id" as="role">
        <card padding="16">
          <column gap="4" main="center">
            <text size="lg">{role.title}</text>
            <text foreground="text_muted" wrap="true">{role.blurb}</text>
            <row gap="8" cross="center">
              <badge>{role.kind}</badge>
              <spacer grow="1"/>
              <button variant="primary" on-press="pick_role:{role.id}">Open</button>
            </row>
          </column>
        </card>
      </for>
    </column>
  </column>
</template>

<!-- The sign-in screen: a PIN pad. The PIN is never stored in the
     clear - `update` hashes it with the installation salt and asks the
     database whether anybody matches. The error line comes from the
     model, so the view never decides whether a sign-in failed. -->

<template name="screen-login">
  <column grow="1" gap="12" padding="32" main="center" cross="center" background="background">
    <text size="heading">Sign in</text>
    <text foreground="text_muted">{role_label} - enter your PIN</text>

    <card padding="16" width="320">
      <column gap="8">
        <text-field
          text="{pin_text}"
          placeholder="PIN"
          label="PIN"
          on-input="pin_edit"
          on-submit="submit_login"
          autofocus="true"
        />
        <if test="{login_failed}">
          <text foreground="destructive">{login_error}</text>
        </if>
        <button variant="primary" on-press="submit_login">Sign in</button>
        <button variant="ghost" on-press="pick_role_again">Change role</button>
      </column>
    </card>
  </column>
</template>
