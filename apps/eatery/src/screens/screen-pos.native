<!-- The point of sale. The menu on the left, the cart on the right.
     The product grid is a virtualized list so a hundred-item menu does
     not blow the widget budget, and the visible slice is a derived
     binding: the filter (category plus search text) is applied in the
     model, never in the markup. -->

<template name="screen-pos">
  <split grow="1" value="{menu_split}" on-resize="menu_resized">
    <column gap="8" padding="16" grow="1">
      <row gap="8" cross="center">
        <search-field
          text="{search_text}"
          placeholder="Search the menu"
          label="Search the menu"
          on-input="search_edit"
          grow="1"
        />
      </row>

      <row gap="4" cross="center">
        <toggle-button selected="{selected_category == 0}" on-toggle="set_category_all">All</toggle-button>
        <for each="categories" key="id" as="category">
          <toggle-button selected="{category.id == selected_category}" on-toggle="set_category:{category.id}">{category.name}</toggle-button>
        </for>
      </row>

      <scroll grow="1">
        <grid columns="4" gap="8">
          <for each="visible_products" key="id" as="product">
            <card padding="8" on-press="add_to_cart:{product.id}">
              <column gap="2">
                <text wrap="true">{product.name}</text>
                <text size="sm" foreground="text_muted">{currency_symbol}{fixed(product.price_minor / 100, 2)}</text>
              </column>
            </card>
          </for>
        </grid>
      </scroll>
    </column>

    <column width="300" gap="8" padding="16" background="surface">
      <text size="lg">Cart</text>
      <row gap="4" cross="center">
        <text size="sm" foreground="text_muted" grow="1">{cart_type_label}</text>
        <for each="order_types" key="id" as="kind">
          <toggle-button selected="{kind.id == cart_order_type}" on-toggle="set_order_type:{kind.id}">{kind.label}</toggle-button>
        </for>
      </row>
      <separator/>

      <if test="{cart_is_empty}">
        <text foreground="text_muted">The cart is empty.</text>
      </if>

      <scroll grow="1">
        <column gap="4">
          <for each="cart_lines" key="product_id" as="line">
            <row gap="8" cross="center">
              <text grow="1">{line.name}</text>
              <text>{line.qty}</text>
              <text>{currency_symbol}{fixed(line.total_minor / 100, 2)}</text>
              <button size="icon" icon="x" label="Remove one" on-press="remove_from_cart:{line.product_id}"/>
            </row>
          </for>
        </column>
      </scroll>

      <separator/>
      <row gap="4" cross="center">
        <text size="sm" foreground="text_muted" grow="1">Discount</text>
        <toggle-button selected="{cart_discount_id == 0}" on-toggle="clear_discount">None</toggle-button>
        <for each="discounts" key="id" as="discount">
          <toggle-button selected="{discount.id == cart_discount_id}" on-toggle="apply_discount:{discount.id}">{discount.name}</toggle-button>
        </for>
      </row>
      <row cross="center">
        <text grow="1">Subtotal</text>
        <text>{currency_symbol}{fixed(cart_total_minor / 100, 2)}</text>
      </row>
      <if test="{cart_tax_minor > 0}">
        <row cross="center">
          <text grow="1">Tax</text>
          <text>{currency_symbol}{fixed(cart_tax_minor / 100, 2)}</text>
        </row>
      </if>
      <if test="{cart_discount_total > 0}">
        <row cross="center">
          <text grow="1">Discount</text>
          <text>{currency_symbol}{fixed(cart_discount_total / 100, 2)}</text>
        </row>
      </if>
      <row cross="center">
        <text grow="1">Total</text>
        <text size="lg">{currency_symbol}{fixed(cart_amount_due / 100, 2)}</text>
      </row>
      <row gap="8">
        <button variant="ghost" on-press="clear_cart">Clear</button>
        <button variant="primary" grow="1" disabled="{sale_pending}" on-press="place_order">Place order</button>
      </row>
    </column>
  </split>
</template>
