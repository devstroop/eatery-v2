<!-- The tax slabs. A slab is a rate the menu prices against; the
     "No tax" slab at zero is the one a product with no tax points at. -->

<template name="screen-settings-tax">
  <column grow="1" gap="12" padding="16" background="background">
    <row gap="8" cross="center">
      <text size="heading" grow="1">Tax slabs</text>
      <badge>{tax_slab_count} slabs</badge>
      <button size="sm" variant="ghost" on-press="open_settings">Back</button>
    </row>

    <scroll grow="1">
      <column gap="4">
        <for each="tax_slabs" key="id" as="slab">
          <row background="surface" radius="md" padding="10" gap="10" cross="center">
            <text grow="1">{slab.name}</text>
            <text>{fixed(slab.rate_bps / 100, 2)}%</text>
            <badge>{slab.tax_label}</badge>
          </row>
        </for>
      </column>
    </scroll>
  </column>
</template>
