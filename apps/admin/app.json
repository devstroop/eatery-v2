{
    "$schema": "https://schema.native-sdk.dev/app/v1.json",
    "id": "com.devstroop.ros.admin",
    "name": "ros-admin",
    "display_name": "Restaurant OS Admin",
    "description": "Restaurant OS back office: point of sale, orders, floor, catalogue, people and settings.",
    "version": "0.1.0",
    "icons": [
        "assets/icon.png"
    ],
    "platforms": [
        "macos",
        "linux",
        "windows"
    ],
    "permissions": [
        "view",
        "command",
        "window",
        "dialog",
        "filesystem",
        "clipboard",
        "network",
        "notifications",
        "credentials"
    ],
    "capabilities": [
        "native_views",
        "gpu_surfaces",
        "sqlite",
        "filesystem",
        "network",
        "clipboard",
        "notifications",
        "credentials",
        "open_url",
        "menus"
    ],
    "shell": {
        "windows": [
            {
                "label": "main",
                "title": "Restaurant OS Admin",
                "width": 1280,
                "height": 800,
                "min_width": 960,
                "min_height": 600,
                "restore_policy": "center_on_primary",
                "views": [
                    {
                        "label": "main-canvas",
                        "kind": "gpu_surface",
                        "fill": true,
                        "role": "Restaurant OS Admin canvas",
                        "accessibility_label": "Restaurant OS Admin",
                        "gpu_backend": "metal",
                        "gpu_pixel_format": "bgra8_unorm",
                        "gpu_present_mode": "timer",
                        "gpu_alpha_mode": "opaque",
                        "gpu_color_space": "srgb",
                        "gpu_vsync": true
                    }
                ]
            }
        ]
    },
    "security": {
        "navigation": {
            "allowed_origins": [
                "zero://app",
                "zero://inline"
            ],
            "external_links": {
                "action": "open_system_browser"
            }
        }
    },
    "web_engine": "system",
    "cef": {
        "dir": "third_party/cef/macos",
        "auto_install": false
    }
}
